{
  "name": "webdcc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "mock:anthropic": "tsx packages/testing/mock-models/src/anthropic-cli.ts",
    "mock:responses": "tsx packages/testing/mock-models/src/responses-cli.ts",
    "probe:codex": "tsx scripts/probe-codex.ts",
    "probe:claude": "tsx scripts/probe-claude.ts",
    "probe:dsh": "tsx scripts/probe-dsh.ts",
    "research:codex-presets": "tsx scripts/research-codex-presets.ts",
    "research:dsh-question": "tsx scripts/research-dsh-question.ts",
    "research:claude-question": "tsx scripts/research-claude-question.ts",
    "build": "pnpm --filter @webdcc/web build && tsx scripts/build-server.ts",
    "dev:server": "tsx scripts/dev-server.ts",
    "dev:web": "pnpm --filter @webdcc/web dev",
    "start": "node packages/server/dist/main.js",
    "accept:m8": "tsx scripts/accept-m8.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "3.2.7",
    "ws": "^8.22.2"
  }
}
